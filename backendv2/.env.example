# PostgreSQL (Railway provee DATABASE_URL automáticamente)
DATABASE_URL=postgresql://user:password@localhost:5432/app_streams

# Secreto JWT (mín. 32 caracteres aleatorios)
JWT_SECRET=change-me-use-openssl-rand-base64-32

# Cifrado AES-256 de contraseñas de servicios (64 hex = 32 bytes)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Origen del frontend (URL de Vercel en producción)
CORS_ORIGIN=http://localhost:3000

PORT=8080
NODE_ENV=development
